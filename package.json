{
  "name": "@graupl/graupl",
  "version": "1.0.0-beta.15",
  "description": "A modular and modern CSS framework.",
  "type": "module",
  "files": [
    "dist",
    "scss"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "commit": "git cz",
    "eslint": "eslint .",
    "prettier": "prettier '**/*.{js,mjs,cjs,scss,sass}'",
    "stylelint": "stylelint '**/*.scss' --allow-empty-input",
    "lint": "npm run eslint -- --fix && npm run stylelint -- --fix && npm run prettier --  --write",
    "presass": "rm -rf dist/css/*",
    "sass": "sass scss:dist/css --pkg-importer=node",
    "sass:packages": "npm --workspaces run sass --if-present",
    "postcss": "postcss 'dist/css/**/*.css' --replace --config ./postcss.config.cjs",
    "postcss:packages": "npm --workspaces run postcss --if-present",
    "css": "npm run sass && npm run postcss",
    "css:packages": "npm --workspaces run css --if-present",
    "prerolldown": "rm -rf dist/js/*",
    "rolldown": "rolldown --config ./rolldown.config.js",
    "rolldown:packages": "npm --workspaces run rolldown --if-present",
    "build": "npm-run-all build:*",
    "build:packages": "npm --workspaces run build --if-present",
    "build:css": "npm run sass && npm run postcss",
    "build:js": "npm run rolldown",
    "postbuild": "npm run docs:build",
    "release": "commit-and-tag-version -a",
    "dev": "vite --config vite.config.js",
    "preview": "vite preview --config vite.config.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Graupl/graupl.git"
  },
  "keywords": [
    "graupl"
  ],
  "author": "Nick Milton",
  "contributors": [
    {
      "name": "Coldfront Labs Inc.",
      "url": "https://coldfrontlabs.ca"
    }
  ],
  "bugs": {
    "url": "https://github.com/Graupl/graupl/issues"
  },
  "license": "ISC",
  "homepage": "https://github.com/Graupl/graupl#readme",
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@drupal/once": "git+https://git.drupalcode.org/issue/once-3466026.git",
    "@eslint/js": "^9.0.0",
    "@rollup/plugin-babel": "^6.0.4",
    "accessible-menu": "^4.2.2",
    "autoprefixer": "^10.4.19",
    "chokidar-cli": "^3.0.0",
    "commit-and-tag-version": "^12.5.1",
    "commitizen": "^4.3.0",
    "cssnano": "^7.0.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^50.2.4",
    "globals": "^15.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "normalize.css": "^8.0.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.0",
    "postcss-discard-comments": "^7.0.0",
    "prettier": "^3.2.5",
    "rolldown": "^1.0.0-beta.19",
    "rollup-plugin-esbuild": "^6.2.1",
    "sass": "npm:sass-embedded@^1.89.2",
    "stylelint": "^16.3.1",
    "stylelint-config-property-sort-order-smacss": "^10.0.0",
    "stylelint-config-sass-guidelines": "^12.1.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-prettier": "^5.0.0",
    "vite": "^5.2.8",
    "vitepress": "^1.1.0"
  },
  "dependencies": {
    "@graupl/core": "*"
  }
}
