{
  "name": "@graupl/graupl",
  "version": "1.0.0-beta.60",
  "license": "GPL-3.0-or-later",
  "description": "A modular and modern CSS framework.",
  "type": "module",
  "files": [
    "dist",
    "scss"
  ],
  "scripts": {
    "prepare": "husky",
    "commit": "git cz",
    "eslint": "eslint .",
    "prettier": "prettier '**/*.{js,mjs,cjs,scss,sass}'",
    "stylelint": "stylelint '**/*.scss' --allow-empty-input",
    "lint": "npm run eslint -- --fix && npm run stylelint -- --fix && npm run prettier --  --write",
    "presass": "rm -rf dist/css/*",
    "precss": "rm -rf dist/css/*",
    "sass": "sass scss:dist/css --pkg-importer=node --embed-sources",
    "css": "node compile-styles.js",
    "build": "npm-run-all build:*",
    "build:css": "npm run css",
    "build:js": "node scripts/copy-core-bundles.js",
    "postbuild": "npm run docs:build && npm run demo:build",
    "release": "commit-and-tag-version -a",
    "demo:dev": "vite",
    "demo:preview": "vite preview",
    "demo:build": "vite build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:package": "node scripts/test-package.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Graupl/graupl.git"
  },
  "keywords": [
    "graupl"
  ],
  "author": "Nick Milton",
  "contributors": [
    {
      "name": "Coldfront Labs Inc.",
      "url": "https://coldfrontlabs.ca"
    }
  ],
  "bugs": {
    "url": "https://github.com/Graupl/graupl/issues"
  },
  "homepage": "https://github.com/Graupl/graupl#readme",
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@eslint/js": "^9.0.0",
    "@graupl/icons": "^1.0.0-beta.60",
    "@graupl/navigation-shelf": "^1.0.0-beta.60",
    "accessible-menu": "^4.2.2",
    "chokidar-cli": "^3.0.0",
    "codemirror": "^6.0.2",
    "commit-and-tag-version": "^12.5.1",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^50.2.4",
    "globals": "^15.0.0",
    "husky": "^9.0.11",
    "jsdom": "^27.4.0",
    "lightningcss": "^1.30.2",
    "lint-staged": "^15.2.2",
    "normalize.css": "^8.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "sass": "^1.89.2",
    "sass-embedded": "^1.89.2",
    "stylelint": "^16.3.1",
    "stylelint-config-property-sort-order-smacss": "^10.0.0",
    "stylelint-config-sass-guidelines": "^12.1.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-prettier": "^5.0.0",
    "vite": "^8.0.14",
    "vitepress": "^1.1.0",
    "vue-codemirror": "^6.1.1"
  },
  "dependencies": {
    "@graupl/core": "^1.0.0-beta.61"
  }
}
