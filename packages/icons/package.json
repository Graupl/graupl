{
  "name": "@graupl/icons",
  "version": "1.0.0-beta.54",
  "license": "GPL-3.0-or-later",
  "description": "A plugin for Graupl that provides bare-minimum icon components.",
  "type": "module",
  "files": [
    "dist",
    "scss",
    "src"
  ],
  "exports": {
    ".": {
      "sass": "./scss/icon.scss"
    },
    "./*.scss": {
      "sass": "./scss/*.scss"
    },
    "./src/*.scss": {
      "sass": "./src/scss/*.scss"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Graupl/graupl.git",
    "directory": "packages/icons"
  },
  "keywords": [
    "graupl"
  ],
  "author": "Nick Milton",
  "contributors": [
    {
      "name": "Coldfront Labs Inc.",
      "url": "https://coldfrontlabs.ca"
    }
  ],
  "bugs": {
    "url": "https://github.com/Graupl/graupl/issues"
  },
  "homepage": "https://github.com/Graupl/graupl/tree/main/packages/icons#readme",
  "scripts": {
    "presass": "rm -rf dist/css/*",
    "precss": "rm -rf dist/css/*",
    "sass": "sass scss:dist/css --pkg-importer=node",
    "css": "node compile-styles.js",
    "build": "npm-run-all build:*",
    "build:css": "npm run css"
  },
  "dependencies": {
    "@graupl/core": "*"
  }
}
