{
  "name": "@graupl/icons",
  "version": "1.0.0-beta.9",
  "description": "A plugin for Graupl that provides bare-minimum icon components.",
  "type": "module",
  "files": [
    "dist",
    "scss",
    "src"
  ],
  "exports": {
    ".": {
      "sass": "./scss/icon.scss"
    },
    "./*.scss": {
      "sass": "./scss/*.scss"
    },
    "./src/*.scss": {
      "sass": "./src/scss/*.scss"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Graupl/graupl.git",
    "directory": "packages/icons"
  },
  "keywords": [
    "graupl"
  ],
  "author": "Nick Milton",
  "contributors": [
    {
      "name": "Coldfront Labs Inc.",
      "url": "https://coldfrontlabs.ca"
    }
  ],
  "bugs": {
    "url": "https://github.com/Graupl/graupl/issues"
  },
  "license": "ISC",
  "homepage": "https://github.com/Graupl/graupl/tree/main/packages/icons#readme",
  "devDependencies": {
    "sass": "^1.89.2"
  },
  "dependencies": {
    "@graupl/core": "*"
  }
}
