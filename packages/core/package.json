{
  "name": "@graupl/core",
  "version": "1.0.0-beta.56",
  "license": "GPL-3.0-or-later",
  "description": "The core module of Graupl, providing essential styles and utilities.",
  "main": "dist/js/graupl.cjs.js",
  "module": "dist/js/graupl.es.js",
  "type": "module",
  "files": [
    "dist",
    "scss",
    "src"
  ],
  "exports": {
    ".": {
      "sass": "./scss/graupl.scss",
      "import": "./dist/js/graupl.es.js",
      "require": "./dist/js/graupl.cjs.js"
    },
    "./*.scss": {
      "sass": "./scss/*.scss"
    },
    "./src/*.scss": {
      "sass": "./src/scss/*.scss"
    },
    "./src/*.js": {
      "import": "./src/js/*.js"
    },
    "./accordion": {
      "import": "./dist/js/component/accordion.es.js",
      "require": "./dist/js/component/accordion.cjs.js"
    },
    "./accordion/generator": {
      "import": "./dist/js/generator/accordion.es.js",
      "require": "./dist/js/generator/accordion.cjs.js"
    },
    "./alert": {
      "import": "./dist/js/component/alert.es.js",
      "require": "./dist/js/component/alert.cjs.js"
    },
    "./alert/generator": {
      "import": "./dist/js/generator/alert.es.js",
      "require": "./dist/js/generator/alert.cjs.js"
    },
    "./breadcrumb": {
      "import": "./dist/js/component/breadcrumb.es.js",
      "require": "./dist/js/component/breadcrumb.cjs.js"
    },
    "./breadcrumb/generator": {
      "import": "./dist/js/generator/breadcrumb.es.js",
      "require": "./dist/js/generator/breadcrumb.cjs.js"
    },
    "./carousel": {
      "import": "./dist/js/component/carousel.es.js",
      "require": "./dist/js/component/carousel.cjs.js"
    },
    "./carousel/generator": {
      "import": "./dist/js/generator/carousel.es.js",
      "require": "./dist/js/generator/carousel.cjs.js"
    },
    "./disclosure": {
      "import": "./dist/js/component/disclosure.es.js",
      "require": "./dist/js/component/disclosure.cjs.js"
    },
    "./disclosure/generator": {
      "import": "./dist/js/generator/disclosure.es.js",
      "require": "./dist/js/generator/disclosure.cjs.js"
    },
    "./navigation/generator": {
      "import": "./dist/js/generator/navigation.es.js",
      "require": "./dist/js/generator/navigation.cjs.js"
    },
    "./tabs": {
      "import": "./dist/js/component/tabs.es.js",
      "require": "./dist/js/component/tabs.cjs.js"
    },
    "./tabs/generator": {
      "import": "./dist/js/generator/tabs.es.js"
    },
    "./tooltip": {
      "import": "./dist/js/component/tooltip.es.js",
      "require": "./dist/js/component/tooltip.cjs.js"
    },
    "./tooltip/generator": {
      "import": "./dist/js/generator/tooltip.es.js",
      "require": "./dist/js/generator/tooltip.cjs.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Graupl/graupl.git",
    "directory": "packages/core"
  },
  "keywords": [
    "graupl"
  ],
  "author": "Nick Milton",
  "contributors": [
    {
      "name": "Coldfront Labs Inc.",
      "url": "https://coldfrontlabs.ca"
    }
  ],
  "bugs": {
    "url": "https://github.com/Graupl/graupl/issues"
  },
  "homepage": "https://github.com/Graupl/graupl/tree/main/packages/core#readme",
  "scripts": {
    "presass": "rm -rf dist/css/*",
    "precss": "rm -rf dist/css/*",
    "sass": "sass scss:dist/css --pkg-importer=node",
    "css": "node compile-styles.js",
    "prerolldown": "rm -rf dist/js/*",
    "rolldown": "rolldown --config ./rolldown.config.js",
    "build": "npm-run-all build:*",
    "build:css": "npm run css",
    "build:js": "npm run rolldown"
  }
}
